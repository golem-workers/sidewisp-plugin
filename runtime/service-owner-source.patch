@@ -0,0 +1,78 @@
+import { expect, it, vi } from "vitest";
+import { createEmptyPluginRegistry } from "./registry.js";
+import {
+  releaseServiceHookOwner,
+  retainServiceHookOwner,
+  resolveServiceOwnedHooks,
+} from "./service-hook-owners.js";
+
+it("keeps live service observers, not registration-only state, without granting missing or different-source hooks", () => {
+  const live = createEmptyPluginRegistry(),
+    scoped = createEmptyPluginRegistry();
+  const record = {
+    id: "collector",
+    source: "/installed/collector/index.js",
+  } as (typeof live.plugins)[number];
+  live.plugins.push(record);
+  scoped.plugins.push({ ...record });
+  const liveFinal = vi.fn(),
+    scopedFinal = vi.fn();
+  const hook = (handler: () => void) => ({
+    pluginId: "collector",
+    source: record.source,
+    hookName: "reply_dispatch" as const,
+    handler,
+  });
+  live.typedHooks.push({ ...hook(liveFinal), priority: 50 });
+  scoped.typedHooks.push({ ...hook(scopedFinal), priority: 1 });
+  const owner = {};
+  retainServiceHookOwner(owner, live, "collector");
+  try {
+    expect(resolveServiceOwnedHooks(scoped).typedHooks[0].handler).toBe(liveFinal);
+    expect(resolveServiceOwnedHooks(scoped).typedHooks[0].priority).toBe(1);
+    const absent = createEmptyPluginRegistry();
+    absent.plugins.push({ ...record });
+    expect(resolveServiceOwnedHooks(absent).typedHooks).toHaveLength(0);
+    scoped.plugins[0] = { ...record, source: "/other/index.js" };
+    expect(resolveServiceOwnedHooks(scoped).typedHooks[0].handler).toBe(scopedFinal);
+    scoped.plugins[0] = record;
+    releaseServiceHookOwner(owner);
+    expect(resolveServiceOwnedHooks(scoped).typedHooks[0].handler).toBe(scopedFinal);
+  } finally {
+    releaseServiceHookOwner(owner);
+  }
+});
+it("retains multiple handlers and declines ambiguous simultaneous service owners", () => {
+  const live = createEmptyPluginRegistry(),
+    scoped = createEmptyPluginRegistry(),
+    other = createEmptyPluginRegistry();
+  const record = {
+    id: "collector",
+    source: "/installed/index.js",
+  } as (typeof live.plugins)[number];
+  for (const r of [live, scoped, other]) r.plugins.push({ ...record });
+  const hook = (handler: () => void) => ({
+    pluginId: "collector",
+    source: record.source,
+    hookName: "before_dispatch" as const,
+    handler,
+  });
+  const first = vi.fn(),
+    second = vi.fn();
+  live.typedHooks.push(hook(first), hook(second));
+  scoped.typedHooks.push(hook(vi.fn()), hook(vi.fn()));
+  const a = {},
+    b = {};
+  retainServiceHookOwner(a, live, "collector");
+  try {
+    expect(resolveServiceOwnedHooks(scoped).typedHooks.map((h) => h.handler)).toEqual([
+      first,
+      second,
+    ]);
+    retainServiceHookOwner(b, other, "collector");
+    expect(resolveServiceOwnedHooks(scoped)).toBe(scoped);
+  } finally {
+    releaseServiceHookOwner(a);
+    releaseServiceHookOwner(b);
+  }
+});
diff --git a/src/plugins/service-hook-owners.ts b/src/plugins/service-hook-owners.ts
new file mode 100644
index 00000000..45d3e375
--- /dev/null
+++ b/src/plugins/service-hook-owners.ts
@@ -0,0 +1,62 @@
+import type { GlobalHookRunnerRegistry } from "./hook-registry.types.js";
+import { isPluginRegistryRetired } from "./registry-lifecycle.js";
+import type { PluginRegistry } from "./registry-types.js";
+
+// A scoped registration can describe the same installed plugin without starting
+// its service. Passive telemetry must reach that service's live state, not a
+// registration-only closure. Never add a hook absent from the caller's registry.
+const ownersKey = Symbol.for("openclaw.plugins.live-service-hook-owners");
+type Owner = { pluginId: string; registry: PluginRegistry };
+const globalOwners = globalThis as typeof globalThis & { [ownersKey]?: Map<object, Owner> };
+const owners = (globalOwners[ownersKey] ??= new Map<object, Owner>());
+const observedHooks = new Set([
+  "before_dispatch",
+  "reply_dispatch",
+  "message_received",
+  "message_sent",
+  "after_tool_call",
+]);
+
+export function retainServiceHookOwner(owner: object, registry: PluginRegistry, pluginId: string) {
+  owners.set(owner, { registry, pluginId });
+}
+export function releaseServiceHookOwner(owner: object) {
+  owners.delete(owner);
+}
+export function resolveServiceOwnedHooks<T extends GlobalHookRunnerRegistry>(registry: T): T {
+  const live = new Map<string, Set<PluginRegistry>>();
+  for (const { pluginId, registry: owned } of owners.values()) {
+    if (isPluginRegistryRetired(owned)) continue;
+    const list = live.get(pluginId) ?? new Set<PluginRegistry>();
+    list.add(owned);
+    live.set(pluginId, list);
+  }
+  let changed = false;
+  const typedHooks = registry.typedHooks.map((hook) => {
+    if (!observedHooks.has(hook.hookName)) return hook;
+    const candidates = live.get(hook.pluginId);
+    if (candidates?.size !== 1) return hook;
+    const owned = candidates.values().next().value!;
+    if (Object.is(owned, registry)) return hook;
+    const scopedRecord = registry.plugins.find((p) => p.id === hook.pluginId);
+    const ownerRecord = owned.plugins.find((p) => p.id === hook.pluginId);
+    if (
+      !scopedRecord ||
+      !ownerRecord ||
+      !("source" in scopedRecord) ||
+      scopedRecord.source !== ownerRecord.source
+    )
+      return hook;
+    const sameKind = (h: typeof hook) =>
+      h.pluginId === hook.pluginId && h.hookName === hook.hookName && h.source === hook.source;
+    const scoped = registry.typedHooks.filter(sameKind);
+    const matches = owned.typedHooks.filter(sameKind);
+    // Preserve each registration and its order, including multiple observers.
+    if (matches.length !== scoped.length) return hook;
+    const replacement = matches[scoped.indexOf(hook)];
+    if (!replacement) return hook;
+    changed = true;
+    return { ...hook, handler: replacement.handler };
+  });
+  return changed ? { ...registry, typedHooks } : registry;
+}
