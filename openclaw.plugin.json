{
  "id": "sidewisp",
  "name": "Sidewisp",
  "description": "Runtime monitoring and Sidewisp-admin scheduled OpenClaw tasks",
  "activation": {
    "onStartup": true
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "endpoint": {
        "type": "string",
        "description": "Sidewisp ingestion API base URL"
      },
      "setupToken": {
        "type": "string",
        "description": "One-time installation token"
      },
      "enabled": {
        "type": "boolean",
        "default": true
      },
      "diagnosticsIntervalMs": {
        "type": "integer",
        "minimum": 60000,
        "maximum": 86400000,
        "default": 900000,
        "description": "Runtime diagnostic collection cadence in milliseconds"
      },
      "diagnosticsMaxRefreshMs": {
        "type": "integer",
        "minimum": 60000,
        "maximum": 86400000,
        "default": 3600000,
        "description": "Maximum interval before an unchanged snapshot is refreshed"
      },
      "usageIntervalMs": {
        "type": "integer",
        "minimum": 60000,
        "maximum": 86400000,
        "default": 300000,
        "description": "Privacy-safe token usage collection cadence in milliseconds"
      }
    }
  },
  "uiHints": {
    "setupToken": {
      "label": "Setup token",
      "sensitive": true
    },
    "endpoint": {
      "label": "Ingestion endpoint"
    }
  },
  "contracts": {
    "tools": [
      "sidewisp_connect"
    ]
  }
}
